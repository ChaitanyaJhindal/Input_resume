# ==============================================================================
# FacultyScreen - Environment Variables Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
MOCK_MODE=True

# Host & Port Settings
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=3000

# Path to directory containing resume files (Source of Truth)
RESUMES_DIR=.

# Groq Vision & LLM API Configuration
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2

# TypeSafe AI / JEV Fast Structured Decision Configuration
TYPESAFE_API_KEY=
JEV_MODEL=jev-v1-fast
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Database Configuration (Defaults to local SQLite if PostgreSQL is not provided)
DATABASE_URL=sqlite:///./data/facultyscreen.db

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
